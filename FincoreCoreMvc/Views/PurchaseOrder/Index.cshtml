@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<FincoreCoreMvc.Models.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Purchase Orders</h2>
            <p class="text-muted mb-0">Division 4 &bull; Procurement Execution</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-circle me-1"></i> + Create New PO
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <span class="text-muted small">Total Orders</span>
                <h3 class="fw-bold mb-0">@Model.Count</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-warning border-4">
                <span class="text-muted small">Draft / Pending</span>
                <h3 class="fw-bold text-warning mb-0">@Model.Count(x => x.Status == "Draft" || x.Status == "Submitted")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-success border-4">
                <span class="text-muted small">Approved Orders</span>
                <h3 class="fw-bold text-success mb-0">@Model.Count(x => x.Status == "Approved")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-primary border-4">
                <span class="text-muted small">Total Value</span>
                <h3 class="fw-bold text-primary mb-0">₹@Model.Sum(x => x.Amount).ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">PO Code</th>
                            <th>Vendor ID</th>
                            <th>Order Date</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var po in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@po.POCode</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Vendor #@po.VendorId</span>
                                    </td>
                                    <td>@po.OrderDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@(po.Items?.Count ?? 0) item(s)</td>
                                    <td class="fw-bold">₹@po.Amount.ToString("N2")</td>
                                    <td>
                                        @if (po.Status == "Draft")
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                        else if (po.Status == "Submitted")
                                        {
                                            <span class="badge bg-warning text-dark">Submitted</span>
                                        }
                                        else if (po.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (po.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else if (po.Status == "Closed")
                                        {
                                            <span class="badge bg-info text-dark">Closed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">@po.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@po.POId" class="btn btn-outline-secondary" title="View Details">
                                                View
                                            </a>
                                            @if (po.Status == "Draft" || po.Status == "Rejected")
                                            {
                                                <a asp-action="Edit" asp-route-id="@po.POId" class="btn btn-outline-primary" title="Edit">
                                                    Edit
                                                </a>
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@po.POId" />
                                                    <input type="hidden" name="status" value="Submitted" />
                                                    <button type="submit" class="btn btn-outline-warning" title="Submit for Approval">
                                                        Submit
                                                    </button>
                                                </form>
                                            }
                                            @if (po.Status == "Submitted")
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@po.POId" />
                                                    <input type="hidden" name="status" value="Approved" />
                                                    <button type="submit" class="btn btn-outline-success" title="Approve">
                                                        Approve
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Delete" asp-route-id="@po.POId" onclick="return confirm('Are you sure you want to delete @po.POCode?');" class="btn btn-outline-danger" title="Delete">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No purchase orders found. Click <strong>+ Create New PO</strong> to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


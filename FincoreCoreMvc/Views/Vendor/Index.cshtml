*@
@{
}


@model List<Vendor>

<a asp-action="AddVendor" class="btn btn-primary">Add Vendor</a>

    <table class="table">

        <thead>
            <tr>
                <th scope="col">VendorId</th>
                <th scope="col">Vendor Code</th>
                <th scope="col">Company</th>
                <th scope="col">Bank Account</th>
                <th scope="col">PAN</th>
                <th scope="col">Performance Score</th>
                <th scope="col">Verified</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        @foreach (var v in Model)
        {
            <tbody>
                <tr>
                    <th scope="row">@v.VendorId</th>

                    <td>@v.VendorCode</td>

                    <td>@v.company_id</td>

                    <td>@v.BankAccount</td>

                    <td>@v.PAN</td>

                    <td>@v.PerformanceScore</td>

                    <td>
                        @(v.IsVerified == 1 ? "Yes" : "No")
                    </td>

                    <td>
                        @(v.IsActive == 1 ? "Active" : "Inactive")
                    </td>

                    <td>
                        <a onclick="return confirm('Are you Sure')"
                           asp-action="DelVendor"
                           asp-route-id="@v.VendorId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                        <a asp-action="UpdVendor"
                           asp-route-id="@v.VendorId"
                           class="btn btn-primary btn-sm">
                            Edit
                        </a>
                    </td>
                </tr>
            </tbody>
        }

    </table>
